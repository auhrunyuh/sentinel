{
  "hooks": {
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "sh scripts/sentinel hook pre-tool", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "sh scripts/sentinel hook post-tool", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "sh scripts/sentinel hook stop", "timeout": 600 }] }
    ]
  }
}
